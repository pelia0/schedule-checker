# Телеграм-бот
TELEGRAM_TOKEN=your_telegram_bot_token_here
CHANNEL_ID=-1234567890

# Посилання на Google Sheets таблиці.
# Розклад є статичним для семестру; його структура читається з CSV, а не
# захардкоджена в bot.py.
BASE_SCHEDULE_CSV_URL=https://docs.google.com/spreadsheets/d/140hArWp4V6zR4h6l2pxOAw0IAULKugCKEMWYf6mS4uE/export?format=csv&gid=0
SUBJECTS_CSV_URL=https://docs.google.com/spreadsheets/d/140hArWp4V6zR4h6l2pxOAw0IAULKugCKEMWYf6mS4uE/export?format=csv&gid=832675788
SEMESTER_CSV_URL=https://docs.google.com/spreadsheets/d/140hArWp4V6zR4h6l2pxOAw0IAULKugCKEMWYf6mS4uE/export?format=csv&gid=1002009379
REPLACEMENTS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQlLOazl1JOcO5xS1-Ryan5BF2lve26w7lRG-hQTk3J48S8uwm8UtvWJmteeCyqVUtxqJVN7RHUc1I-/pub?output=csv&gid=0
# Старий SCHEDULE_URL залишений для сумісності зі старими .env; нова логіка
# використовує REPLACEMENTS_CSV_URL.
SCHEDULE_URL=
BIRTHDAY_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=YOUR_GID

# Час перевірки (формат ГГ:ХХ)
SCHEDULE_CHECK_TIME=17:00
BIRTHDAY_CHECK_TIME=08:00

# Назва групи для пошуку в розкладі
# Приклади: Т-32, А-31, КІ-15
# Бот автоматично враховує: кирилицю/латиницю, різні тире (-/–/—), пробіли
SCHEDULE_GROUP=T-32

# Необов'язково: числовий приватний chat_id для --test-schedule.
# @username напряму Telegram Bot API не приймає для приватних чатів; якщо
# залишити порожнім, бот спробує знайти @pelia0 серед getUpdates.
PRIVATE_TEST_CHAT_ID=
PRIVATE_TEST_USERNAME=@pelia0

# Локальний кеш CSV (дозволяє працювати при тимчасовому збої Google Sheets)
SCHEDULE_CACHE_FILE=schedule_cache.json
